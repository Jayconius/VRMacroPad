# dependencies and build output
node_modules/
dist/
build/
.helper-build/
*.exe
*.blockmap

# local-only: test tools, dev data, editor / tool folders
dev-tools/
tools/
.art-tmp/
.devdata/
.claude/
.vscode/
.idea/

# your own data, in case a data folder ever ends up next to the code
secrets.json
plugins/kick/kick-app.json
plugins/youtube/youtube-app.json
plugins/voicemod/voicemod-app.json
# the private sign-in helpers (Cloudflare Workers) and their set-up guides: they stay on the developer PC
plugins/*/broker/
auth.json
runtime.json
.env

# logs, caches, OS files
*.log
*.tmp
__pycache__/
*.pyc
coverage/
Thumbs.db
.DS_Store

# dev-only notes, the overlay dev launcher and probes stay on the developer PC
docs/dev/
Start Overlay Dev.bat
scripts/overlay-flicker-probe.js

# keys, certificates and deployment files must never be committed, wherever they end up
*.pem
*.key
*.pfx
*.p12
.key-secret
issued-keys.txt
revoked-keys.txt
client_secret*.json
.dev.vars
.wrangler/
wrangler.toml
